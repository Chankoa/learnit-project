NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_ADMIN=true

# Server-only. Never expose these with NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-only-if-account-deletion-is-enabled

# Forge AI providers: mock, openai-compatible, openai, ai-sdk.
# ai-sdk is the Sprint 9.3 experimental provider and remains server-only.
AI_PROVIDER=openai-compatible
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=replace-with-server-only-key
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=60000
FORGE_AI_MAX_INPUT_CHARS=30000
FORGE_AI_MAX_OUTPUT_TOKENS=1200
FORGE_AI_RATE_LIMIT_PER_HOUR=20

# Legacy aliases - deprecated. Do not define these for new deployments.
# NEXT_PUBLIC_SITE_URL=
# AI_MODEL=
# AI_API_KEY=
